class DashboardStatsView(APIView):
    permission_classes = [AllowAny]

    def get(self, request):
        from datetime import date
        from django.db.models import Sum, Q
        from patients.models import Patient
        from appointments.models import Appointment, Service, Doctor
        from billing.models import Invoice

        today = date.today()
        
        total_patients = Patient.objects.filter(is_active=True).count()
        total_appointments_today = Appointment.objects.filter(
            appointment_date=today
        ).count()
        total_services = Service.objects.filter(is_active=True).count()
        total_doctors = Doctor.objects.filter(is_active=True).count()
        
        revenue_today = Invoice.objects.filter(
            status='paid',
            payment_date=today
        ).aggregate(Sum('total_amount'))['total_amount__sum'] or 0
        
        return Response({
            'total_patients': total_patients,
            'total_appointments_today': total_appointments_today,
            'total_services': total_services,
            'total_doctors': total_doctors,
            'revenue_today': revenue_today,
        })


# ==================== PUBLIC STATS ====================

@api_view(['GET'])
@permission_classes([AllowAny])
def public_stats(request):
    from datetime import date
    from django.db.models import Sum, Q
    from patients.models import Patient
    from appointments.models import Appointment, Service, Doctor
    from billing.models import Invoice
    
    today = date.today()
    
    return Response({
        'total_patients': Patient.objects.filter(is_active=True).count(),
        'total_appointments_today': Appointment.objects.filter(appointment_date=today).count(),
        'total_services': Service.objects.filter(is_active=True).count(),
        'total_doctors': Doctor.objects.filter(is_active=True).count(),
        'revenue_today': Invoice.objects.filter(
            status='paid',
            payment_date=today
        ).aggregate(Sum('total_amount'))['total_amount__sum'] or 0,
        'message': 'Public stats - working!'
    })

# ==================== DIRECT STATS - NO PERMISSIONS ====================
def simple_stats_direct(request):
    from django.http import JsonResponse
    from django.db.models import Sum, Q
    from datetime import date
    from patients.models import Patient
    from appointments.models import Appointment, Service, Doctor
    from billing.models import Invoice
    
    today = date.today()
    
    data = {
        'total_patients': Patient.objects.filter(is_active=True).count(),
        'total_appointments_today': Appointment.objects.filter(appointment_date=today).count(),
        'total_services': Service.objects.filter(is_active=True).count(),
        'total_doctors': Doctor.objects.filter(is_active=True).count(),
        'revenue_today': Invoice.objects.filter(
            status='paid',
            payment_date=today
        ).aggregate(Sum('total_amount'))['total_amount__sum'] or 0,
        'message': 'Stats working!'
    }
    return JsonResponse(data)

